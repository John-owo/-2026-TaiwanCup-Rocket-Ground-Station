      "css": ".ds-badges{display:flex;gap:12px;padding:16px;background:var(--sheet,#f6f8f4);} .ds-deploy{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border:1.5px solid var(--live,#1d7444);border-radius:var(--radius,4px);color:var(--live,#1d7444);font:700 15px/1.2 Barlow,sans-serif;letter-spacing:.06em;} .ds-deploy.ds-deployed{border-color:var(--danger,#b3261e);background:var(--danger,#b3261e);color:#fff;}"
