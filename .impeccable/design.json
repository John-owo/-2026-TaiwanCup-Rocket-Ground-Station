      "html": "<div class=\"ds-rail-demo2\"><section class=\"ds-link\"><div class=\"ds-link-state\"><i></i><strong>接收中</strong></div><dl><dt>最後封包</dt><dd>0.2 s 前</dd><dt>接收頻率</dt><dd>1.67 Hz</dd><dt>遺失 / CRC</dt><dd>2 / 0</dd></dl></section></div>",
      "css": ".ds-rail-demo2{padding:20px;background:var(--rail,#1b4f8f);color:var(--rail-ink,#eef3fa);font-family:\"Microsoft JhengHei UI\",\"Microsoft JhengHei\",sans-serif;} .ds-link{padding:14px 14px 12px;border-radius:var(--radius-lg,6px);background:var(--rail-deep,#143d70);} .ds-link-state{display:flex;align-items:center;gap:10px;} .ds-link-state strong{font-size:20px;font-weight:700;line-height:1.1;} .ds-link-state i{width:12px;height:12px;border:2px solid var(--live-on-rail,#7ee0a6);border-radius:50%;background:var(--live-on-rail,#7ee0a6);} .ds-link dl{display:grid;grid-template-columns:auto 1fr;gap:5px 12px;margin:12px 0 0;font-size:13px;} .ds-link dt{color:var(--rail-ink-2,#c3d3e8);} .ds-link dd{margin:0;text-align:right;font-weight:600;font-family:Barlow,sans-serif;font-variant-numeric:tabular-nums;}"
