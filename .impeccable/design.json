      "css": ".ds-status{display:flex;align-items:center;gap:20px;min-height:34px;padding:0 20px;border-top:1px solid var(--rule,#c6cec5);background:var(--paper-2,#e3e8e1);color:var(--ink-2,#435168);font:400 12.5px \"Microsoft JhengHei UI\",\"Microsoft JhengHei\",sans-serif;white-space:nowrap;} .ds-item{display:inline-flex;align-items:baseline;gap:6px;} .ds-item b{color:var(--ink,#0f1b2d);font:600 13.5px Barlow,sans-serif;font-variant-numeric:tabular-nums;} .ds-warn b{color:var(--warn,#8f5200);} .ds-live{align-items:center;color:var(--ink,#0f1b2d);font-weight:600;} .ds-live i{width:9px;height:9px;border:1.5px solid var(--live,#1d7444);border-radius:50%;background:var(--live,#1d7444);}"
    }
