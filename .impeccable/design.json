      "css": ".ds-release{display:grid;grid-template-columns:1fr 1.25fr 1.25fr;gap:8px;padding:16px;background:var(--sheet,#f6f8f4);} .ds-arm,.ds-fire{min-height:50px;border-radius:var(--radius,4px);font:700 14.5px/1 \"Microsoft JhengHei UI\",\"Microsoft JhengHei\",sans-serif;cursor:pointer;} .ds-arm{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1.5px solid var(--danger,#b3261e);background:transparent;color:var(--danger,#b3261e);} .ds-arm:hover{background:var(--danger-soft,rgba(179,38,30,.09));} .ds-arm:focus-visible,.ds-fire:focus-visible{outline:2px solid var(--rail,#1b4f8f);outline-offset:2px;} .ds-fire{border:0;font-family:Barlow,sans-serif;letter-spacing:.05em;background:repeating-linear-gradient(-45deg,var(--paper-2,#e3e8e1) 0 8px,var(--rule,#c6cec5) 8px 16px);color:var(--ink-3,#5f6c80);} .ds-fire:disabled{cursor:not-allowed;} .ds-fire.ds-ready{background:var(--danger,#b3261e);color:#fff;} .ds-fire.ds-ready:hover{filter:brightness(1.08);}"
